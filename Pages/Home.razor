@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Rainy Day</PageTitle>

<canvas @ref="_canvas" class="scene" aria-label="A cozy room with rain falling outside the window"></canvas>

@if (_webGlFailed)
{
    <div class="overlay">
        <div class="paper card">
            <h1>Rainy Day</h1>
            <p>Your browser couldn't start WebGL, so the room can't be drawn. A recent Chrome, Edge, Firefox or Safari should do it.</p>
        </div>
    </div>
}
else if (!_entered)
{
    <div class="overlay">
        <div class="paper card intro">
            <span class="tape tl" aria-hidden="true"></span>
            <span class="tape tr" aria-hidden="true"></span>

            <p class="kicker">a little room for rainy days</p>
            <h1>Rainy Day</h1>
            <svg class="squiggle" viewBox="0 0 300 18" aria-hidden="true" preserveAspectRatio="none">
                <path d="M3 11 C 38 2, 66 18, 106 9 S 186 3, 226 11 S 280 14, 297 6" />
            </svg>
            <p class="tagline">pull up a chair, the kettle's on.</p>

            @if (_scenes.Length > 1)
            {
                <p class="label">pick a room</p>
                <RoomTabs Scenes="_scenes" Current="@_sceneId" OnPick="SelectAsync" Big="true" />
                <p class="blurb">@CurrentBlurb</p>
            }

            <button class="btn enter" disabled="@(!_sceneReady)" @onclick="EnterAsync">
                @(_sceneReady ? "come in" : "warming up…")
            </button>
            <p class="hint">sound on · headphones help@(_scenes.Length > 1 ? " · arrow keys change rooms" : "") · press L to look out the window</p>
        </div>
    </div>
}
else
{
    <header class="topbar">
        @if (_scenes.Length > 1)
        {
            <RoomTabs Scenes="_scenes" Current="@_sceneId" OnPick="SelectAsync" OnStep="StepAsync" Arrows="true" />
        }
        <button class="look @(_lookOut ? "on" : "")" aria-pressed="@(_lookOut ? "true" : "false")" @onclick="ToggleLookAsync">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="1.5" /><path d="M12 4v16M4 12h16" /></svg>
            <span>@(_lookOut ? "back to the room" : "look out the window")</span>
        </button>
    </header>

    <button class="notes-tab" aria-expanded="@(_panelOpen ? "true" : "false")" @onclick="() => _panelOpen = !_panelOpen">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1-5L16 4l4 4L9 19z M14 6l4 4" /></svg>
        <span>@(_panelOpen ? "close" : "notes")</span>
    </button>

    @if (_panelOpen)
    {
        <section class="paper notes" aria-label="Controls">
            <span class="tape tl" aria-hidden="true"></span>
            <h2>notes</h2>

            <div class="checks">
                <button class="check @(_soundOn ? "on" : "")" role="switch" aria-checked="@(_soundOn ? "true" : "false")" @onclick="ToggleSoundAsync">
                    <span class="box"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 11 L8 16 L17 4" /></svg></span>
                    <span>sound</span>
                </button>
                <button class="check @(_thunder ? "on" : "")" role="switch" aria-checked="@(_thunder ? "true" : "false")" @onclick="ToggleThunderAsync">
                    <span class="box"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 11 L8 16 L17 4" /></svg></span>
                    <span>thunder</span>
                </button>
            </div>

            <label class="slider">
                <span class="name">volume <em>@_volume</em></span>
                <input type="range" min="0" max="100" value="@_volume" @oninput="OnVolumeAsync" />
            </label>
            <label class="slider">
                <span class="name">rain <em>@_rain</em></span>
                <input type="range" min="0" max="100" value="@_rain" @oninput="OnRainAsync" />
            </label>
            <label class="slider">
                <span class="name">lamp glow <em>@_warmth</em></span>
                <input type="range" min="0" max="100" value="@_warmth" @oninput="OnWarmthAsync" />
            </label>
        </section>
    }
}

@code {
    public class SceneInfo
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Blurb { get; set; } = "";
    }

    private ElementReference _canvas;
    private IJSObjectReference? _scene;
    private IJSObjectReference? _audio;
    private DotNetObjectReference<Home>? _self;

    private SceneInfo[] _scenes = Array.Empty<SceneInfo>();
    private string _sceneId = "";
    private bool _sceneReady;
    private bool _webGlFailed;
    private bool _entered;
    private bool _lookOut;
    private bool _panelOpen = true;
    private bool _soundOn = true;
    private bool _thunder = true;
    private int _volume = 60;
    private int _rain = 60;
    private int _warmth = 65;

    private string CurrentBlurb => _scenes.FirstOrDefault(s => s.Id == _sceneId)?.Blurb ?? "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _self = DotNetObjectReference.Create(this);
        _scene = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cozyScene.js");
        _audio = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cozyAudio.js");

        var ok = await _scene.InvokeAsync<bool>("init", _canvas, new
        {
            rain = _rain / 100.0,
            warmth = _warmth / 100.0,
            thunder = _thunder,
            dotnet = _self
        });

        if (ok)
        {
            _scenes = await _scene.InvokeAsync<SceneInfo[]>("getScenes");
            _sceneId = await _scene.InvokeAsync<string>("currentScene");
            // Start with the notes tucked away on phones so the room gets the whole screen.
            _panelOpen = !await _scene.InvokeAsync<bool>("isNarrow");
            _sceneReady = true;
        }
        else
        {
            _webGlFailed = true;
        }

        StateHasChanged();
    }

    // Called from JS when the L key toggles the window view.
    [JSInvokable]
    public void OnLookChanged(bool on)
    {
        _lookOut = on;
        StateHasChanged();
    }

    private async Task ToggleLookAsync()
    {
        if (_scene is null) return;
        var want = !_lookOut;
        if (await _scene.InvokeAsync<bool>("setLookOut", want)) _lookOut = want;
    }

    // Called from JS when the keyboard changes the room.
    [JSInvokable]
    public void OnSceneChanged(string id)
    {
        _sceneId = id;
        StateHasChanged();
    }

    private async Task SelectAsync(string id)
    {
        if (_scene is null || id == _sceneId) return;
        _sceneId = id;
        await _scene.InvokeAsync<SceneInfo>("setScene", id);
    }

    private async Task StepAsync(int delta)
    {
        if (_scenes.Length == 0) return;
        var i = Array.FindIndex(_scenes, s => s.Id == _sceneId);
        var next = _scenes[(i + delta + _scenes.Length) % _scenes.Length];
        await SelectAsync(next.Id);
    }

    private async Task EnterAsync()
    {
        // Browsers only allow audio after a user gesture, so sound starts here.
        _entered = true;
        if (_audio is not null)
        {
            await _audio.InvokeVoidAsync("start", _volume / 100.0, _rain / 100.0, _thunder);
        }
    }

    private async Task ToggleSoundAsync()
    {
        _soundOn = !_soundOn;
        if (_audio is not null) await _audio.InvokeVoidAsync("setMuted", !_soundOn);
    }

    private async Task ToggleThunderAsync()
    {
        _thunder = !_thunder;
        if (_scene is not null) await _scene.InvokeVoidAsync("setThunder", _thunder);
        if (_audio is not null) await _audio.InvokeVoidAsync("setThunder", _thunder);
    }

    private async Task OnVolumeAsync(ChangeEventArgs e)
    {
        _volume = ParsePercent(e);
        if (_audio is not null) await _audio.InvokeVoidAsync("setVolume", _volume / 100.0);
    }

    private async Task OnRainAsync(ChangeEventArgs e)
    {
        _rain = ParsePercent(e);
        if (_scene is not null) await _scene.InvokeVoidAsync("setRain", _rain / 100.0);
        if (_audio is not null) await _audio.InvokeVoidAsync("setRain", _rain / 100.0);
    }

    private async Task OnWarmthAsync(ChangeEventArgs e)
    {
        _warmth = ParsePercent(e);
        if (_scene is not null) await _scene.InvokeVoidAsync("setWarmth", _warmth / 100.0);
    }

    private static int ParsePercent(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 0, 100) : 0;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_scene is not null)
            {
                await _scene.InvokeVoidAsync("dispose");
                await _scene.DisposeAsync();
            }
            if (_audio is not null)
            {
                await _audio.InvokeVoidAsync("stop");
                await _audio.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Page is closing; nothing to clean up.
        }
        _self?.Dispose();
    }
}
